{
  "name": "cloudhub-tools",
  "private": true,
  "version": "0.1.41",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlphp/cloudhub-tools.git"
  },
  "homepage": "https://github.com/wlphp/cloudhub-tools",
  "bugs": {
    "url": "https://github.com/wlphp/cloudhub-tools/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "node scripts/mobile-target.mjs dev",
    "web:api": "node web-api.mjs",
    "verify:platform-contracts": "node scripts/verify-platform-contracts.mjs",
    "verify:rust-boundary": "node scripts/verify-rust-command-boundary.mjs",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:bundle-artifacts": "node scripts/verify-bundle-artifacts.mjs",
    "verify:resource-contracts": "node scripts/verify-resource-contracts.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ui:mobile": "npm run build:mobile && playwright test --config playwright.mobile.config.ts",
    "build": "tsc && vite build",
    "build:mobile": "node scripts/mobile-target.mjs build",
    "bundle:mac": "tauri build --target universal-apple-darwin",
    "bundle:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "bundle:mac:x64": "tauri build --target x86_64-apple-darwin",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android": "tauri android",
    "tauri:ios": "tauri ios"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
