{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile-main",
  "description": "Mobile main window capability",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "cloudhub-mobile-updater:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-default-urls",
      "allow": [
        { "url": "https://github.com/wlphp/cloudhub-tools/releases/latest" }
      ]
    },
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-open-app-settings"
  ]
}
